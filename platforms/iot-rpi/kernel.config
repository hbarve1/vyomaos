# Linux kernel configuration for IoT Raspberry Pi (ARM64) platform.
#
# Based on allnoconfig + minimum drivers for VyomaOS on RPi 4:
#   - ARM64 (AArch64) architecture
#   - virtio block, network, 9P filesystem
#   - DRM/KMS simple framebuffer (optional for headless IoT)
#   - Serial UART console
#   - No USB, no ACPI, no legacy drivers
#
# To build: make ARCH=arm64 CROSS_COMPILE=aarch64-linux-musl- bzImage
#
# This file mirrors the desktop-x86 allnoconfig philosophy but for ARM64.
# Run `make ARCH=arm64 allnoconfig` and apply these fragments, or use
# this file directly as a defconfig.

# ── Architecture ──────────────────────────────────────────────────────────────
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_MMU=y

# ── Kernel features ───────────────────────────────────────────────────────────
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_PREEMPT=y
CONFIG_HZ_250=y
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── Serial console ────────────────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── Filesystems ───────────────────────────────────────────────────────────────
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── virtio transport (QEMU virt machine) ──────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# ── 9P filesystem for persistent /data ───────────────────────────────────────
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ── Networking (minimal — for HTTP server app) ────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_TCP_CONG_CUBIC=y

# ── Block layer ───────────────────────────────────────────────────────────────
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# ── DRM / framebuffer (optional — IoT targets may be headless) ────────────────
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ── Random number generator ───────────────────────────────────────────────────
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_CRYPTO_DEV_VIRTIO=y
CONFIG_RANDOM_TRUST_CPU=y

# ── Timer / clocksource ───────────────────────────────────────────────────────
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_ARCH_TIMER_EVTSTREAM=y

# ── PSCI / power management ───────────────────────────────────────────────────
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_PSCI_CPUIDLE=n

# ── GPIO / I2C / SPI / UART (IoT HAL drivers) ────────────────────────────────
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=y
CONFIG_SERIAL_NONSTANDARD=y

# ── Explicitly disabled ───────────────────────────────────────────────────────
CONFIG_USB=n
CONFIG_ACPI=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_CPU_FREQ=n
CONFIG_INPUT=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_SOUND=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_BLUETOOTH=n
