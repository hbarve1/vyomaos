# Kernel config — ARM64 server platform
#
# Strategy: allnoconfig base + only the subsystems VyomaOS server needs:
#   - ARM64 core (Cortex-A, GIC, PL011 UART)
#   - virtio-net (network capability)
#   - virtio-9p (filesystem persistence via /data)
#   - virtio-pci (hypervisor virtio bus)
#   - No DRM, no fbcon, no display subsystem
#   - No USB, no ACPI (QEMU virt machine uses device-tree)
#
# This config targets QEMU aarch64 -M virt for CI and dev;
# real ARM64 server boards require board-specific additions.

# ── Core architecture ──────────────────────────────────────────────────────────
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_ARCH_VIRT=y

# ── CPU support ────────────────────────────────────────────────────────────────
CONFIG_ARCH_MULTI_V8=y
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# ── MMU + memory ──────────────────────────────────────────────────────────────
CONFIG_MMU=y
CONFIG_HIGHMEM=y
CONFIG_SWAP=n

# ── Serial console ─────────────────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── Interrupt controller ───────────────────────────────────────────────────────
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y

# ── PCI + virtio bus ──────────────────────────────────────────────────────────
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_RING=y
CONFIG_VIRTIO_BALLOON=n

# ── Network: virtio-net only (no physical NICs) ────────────────────────────────
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_PACKET=y
CONFIG_VIRTIO_NET=y

# ── Filesystem: tmpfs (rootfs) + 9P (persistent data) ─────────────────────────
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=n

# ── Initramfs ──────────────────────────────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y

# ── Block devices (minimal — no disk needed beyond initramfs) ──────────────────
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=n

# ── No display subsystem ───────────────────────────────────────────────────────
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set

# ── No USB ─────────────────────────────────────────────────────────────────────
# CONFIG_USB is not set
# CONFIG_USB_SUPPORT is not set

# ── No sound ──────────────────────────────────────────────────────────────────
# CONFIG_SOUND is not set

# ── Security (minimal) ─────────────────────────────────────────────────────────
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# CONFIG_SECURITY is not set

# ── Build options ──────────────────────────────────────────────────────────────
CONFIG_KERNEL_GZIP=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
# CONFIG_DEBUG_INFO is not set
CONFIG_PRINTK=y
