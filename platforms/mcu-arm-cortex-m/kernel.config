# Kernel config — MCU ARM Cortex-M platform
#
# ARM Cortex-M targets are bare-metal (no Linux kernel).
# This file documents the HAL/runtime configuration instead.
#
# For QEMU ARM Cortex-M3 emulation (mps2-an385 machine):
#   - No Linux kernel — supervisor runs as bare-metal firmware
#   - wasm3 interpreter for WASM execution
#   - UART0 console (semihosting for QEMU)
#   - No filesystem, no networking, no display
#
# For real MCUs (STM32, nRF52, etc.):
#   - RTOS-less bare-metal or RTOS (FreeRTOS/Zephyr) depending on target
#   - Flash: supervisor + wasm3 + WASM apps in embedded flash
#   - RAM: 256 KB minimum for wasm3 + one WASM module
#
# This file serves as documentation; the MCU build does not use a Linux
# kernel config.  See mcu-minimal.toml for the VyomaOS platform profile.

# ── Memory layout (typical STM32F4 / nRF52840) ───────────────────────────────
# Flash: 512 KB (0x08000000 – 0x08080000)
#   0x08000000 – 0x08010000  VyomaOS supervisor (64 KB)
#   0x08010000 – 0x08040000  wasm3 interpreter   (192 KB)
#   0x08040000 – 0x08080000  WASM app(s)         (256 KB)
#
# RAM: 256 KB (0x20000000 – 0x20040000)
#   0x20000000 – 0x20010000  supervisor stack + heap (64 KB)
#   0x20010000 – 0x20040000  wasm3 linear memory     (192 KB)
#
# ── wasm3 interpreter configuration ──────────────────────────────────────────
# WASM3_MAX_STACK_SLOTS = 2048
# WASM3_MAX_MEMORY_PAGES = 3       (3 × 64KB = 192 KB)
# WASM3_ENABLE_WASI = 1
# WASM3_ENABLE_FLOAT = 1
#
# ── UART console ─────────────────────────────────────────────────────────────
# UART0 at 115200 8N1 for supervisor log output
# SEMIHOSTING enabled for QEMU (-semihosting-config enable=on)
#
# ── HAL drivers (IoT capabilities) ───────────────────────────────────────────
# GPIO: enabled (pins declared per-module in vyoma.toml)
# I2C:  enabled (bus 0, sensors)
# SPI:  enabled (bus 0, flash/radio)
# UART: enabled (port 0, debug; port 1, app I/O)
# ADC:  enabled (channels 0-3)
