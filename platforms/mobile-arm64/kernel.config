# Kernel config — ARM64 mobile platform (TM06)
#
# Based on allnoconfig + additions for VyomaOS mobile target:
#   - ARM64 architecture (64-bit ARMv8)
#   - virtio-gpu for framebuffer (QEMU + physical virtio)
#   - virtio-input for touchscreen input events (EV_ABS device)
#   - DRM for display subsystem
#   - 9P for host-mounted /data (persistent storage)
#   - No USB stack (simplified kernel)
#
# Physical hardware: ARM64 SBC with DRM panel + I2C touchscreen.
# CI target: QEMU aarch64 with virtio-gpu + virtio-input-tablet.

# ── Architecture ──────────────────────────────────────────────────────────────
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# ── Core kernel ───────────────────────────────────────────────────────────────
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_TMPFS=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_MQUEUE=y

# ── Filesystems ───────────────────────────────────────────────────────────────
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# 9P for /data mount (virtio passthrough from QEMU host)
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ── VirtIO subsystem ──────────────────────────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
# virtio-input: touchscreen (EV_ABS) and keyboard events
CONFIG_VIRTIO_INPUT=y
# 9P over virtio transport
CONFIG_VIRTIO_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# ── DRM + framebuffer (virtio-gpu) ────────────────────────────────────────────
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FB_EFI=y

# ── Input subsystem (touchscreen via virtio-input) ────────────────────────────
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
# EV_ABS events for absolute touch coordinates
CONFIG_INPUT_EVDEV=y

# ── Serial console ────────────────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── Networking (minimal — for wasmtime WASI sockets) ─────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# ── Memory + init ─────────────────────────────────────────────────────────────
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_INITRD=y

# ── ARM64 platform drivers ────────────────────────────────────────────────────
# Generic ARM64 platform — no platform-specific BSP required for QEMU target.
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V2M=y
CONFIG_ARM_GIC_V3=y
CONFIG_ACPI=y
CONFIG_ACPI_TABLE_UPGRADE=y
CONFIG_EFI=y
CONFIG_RESET_CONTROLLER=y
CONFIG_POWER_SUPPLY=y

# ── Disabled (keep kernel minimal) ───────────────────────────────────────────
# CONFIG_USB is not set
# CONFIG_SOUND is not set
# CONFIG_WIRELESS is not set
# CONFIG_BLUETOOTH is not set
