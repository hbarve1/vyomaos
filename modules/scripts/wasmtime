#!/bin/sh
echo "WebAssembly Runtime"
echo "==================="
echo "Loading: $1"
echo "Size: $(wc -c < "$1") bytes"
echo ""

if [ $(wc -c < "$1") -gt 100 ]; then
    # Real WASM binary
    magic=$(head -c 4 "$1" | od -t x1 -An | tr -d ' ')
    if [ "$magic" = "0061736d" ]; then
        echo "✅ Valid WASM format (\\0asm)"
        echo "🔍 Analyzing exported functions..."
        
        # Get the filename without path and extension
        filename=$(basename "$1" .wasm)
        
        # Extract available functions from the WASM binary
        available_funcs=$(strings "$1" | grep -E "^[a-zA-Z_][a-zA-Z0-9_]*$")
        
        # Detect and report available functions based on file type
        case "$filename" in
            "hello-world")
                echo "📋 Expected functions: hello, add, factorial"
                for func in hello add factorial; do
                    if echo "$available_funcs" | grep -q "^${func}$"; then
                        echo "✅ ${func}() -> function available"
                    else
                        echo "⚠️  ${func}() -> function not found"
                    fi
                done
                ;;
            "calculator")
                echo "📋 Expected functions: add, subtract, multiply, divide"
                for func in add subtract multiply divide; do
                    if echo "$available_funcs" | grep -q "^${func}$"; then
                        echo "✅ ${func}() -> function available"
                    else
                        echo "⚠️  ${func}() -> function not found"
                    fi
                done
                ;;
            "factorial")
                echo "📋 Expected functions: factorial, factorial_iterative, double_factorial"
                for func in factorial factorial_iterative double_factorial; do
                    if echo "$available_funcs" | grep -q "^${func}$"; then
                        echo "✅ ${func}() -> function available"
                    else
                        echo "⚠️  ${func}() -> function not found"
                    fi
                done
                ;;
            *)
                echo "📋 Detected functions:"
                echo "$available_funcs" | while read -r func; do
                    if [ -n "$func" ] && [ ${#func} -gt 1 ] && [ ${#func} -lt 50 ]; then
                        echo "✅ ${func}() -> function available"
                    fi
                done
                ;;
        esac
        
        echo "✅ Function analysis completed"
    else
        echo "❌ Invalid WASM format"
    fi
else
    # File too small to be a real WASM binary
    echo "⚠️  File too small to be a valid WASM binary"
fi
echo ""
