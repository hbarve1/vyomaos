#!/bin/sh
# VyomaOS WebAssembly Runtime Wrapper (no simulation)

echo "WebAssembly Runtime"
echo "==================="
echo "Loading: $1"
echo "Size: $(wc -c < "$1") bytes"
echo ""

# Prefer embedded runtime in the initramfs
if [ -x "/usr/bin/wasmtime-real" ]; then
    exec /usr/bin/wasmtime-real "$@"
fi

# Fallback to system-installed wasmtime if available
if command -v wasmtime >/dev/null 2>&1; then
    exec wasmtime "$@"
fi

# Fallback to user-local install
if [ -x "$HOME/.wasmtime/bin/wasmtime" ]; then
    exec "$HOME/.wasmtime/bin/wasmtime" "$@"
fi

echo "❌ No Wasmtime runtime available (looked for /usr/bin/wasmtime-real, wasmtime in PATH, and $HOME/.wasmtime/bin/wasmtime)" >&2
exit 127
