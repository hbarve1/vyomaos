# VyomaOS kernel configuration
# Applied via: make KCONFIG_ALLCONFIG=base/kernel.config allnoconfig
# Starts from allnoconfig (everything=n); only what is listed here is enabled.
# All options are built-in (=y). Loadable modules are disabled.

# ── Architecture ──────────────────────────────────────────────────────────────
CONFIG_64BIT=y
CONFIG_X86_64=y

# ── ELF / executable support ──────────────────────────────────────────────────
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# ── Initramfs ─────────────────────────────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── Core virtual filesystems ──────────────────────────────────────────────────
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ── Serial console (8250 UART — standard QEMU ISA serial) ────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# ── Console / printk ─────────────────────────────────────────────────────────
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y

# ── Clock source ─────────────────────────────────────────────────────────────
CONFIG_HZ_100=y

# ── PCI bus (required for virtio-pci) ────────────────────────────────────────
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# ── Block layer ───────────────────────────────────────────────────────────────
CONFIG_BLOCK=y

# ── Disable loadable modules ──────────────────────────────────────────────────
# CONFIG_MODULES is not set

# ── Networking base layer ─────────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# ── Process management ───────────────────────────────────────────────────────
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# ── Filesystem basics ────────────────────────────────────────────────────────
CONFIG_EXT4_FS=y

# ── Disable swap ─────────────────────────────────────────────────────────────
# CONFIG_SWAP is not set

# ── Security ─────────────────────────────────────────────────────────────────
# CONFIG_AUDIT is not set
# CONFIG_IKCONFIG is not set
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# ── VirtIO core ───────────────────────────────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
# Explicit ring buffer — normally auto-selected, but allnoconfig requires it stated
CONFIG_VIRTIO_RING=y

# ── VirtIO transport: PCI ─────────────────────────────────────────────────────
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# ── VirtIO block device (/dev/vda) ────────────────────────────────────────────
CONFIG_VIRTIO_BLK=y

# ── VirtIO network device ─────────────────────────────────────────────────────
CONFIG_VIRTIO_NET=y

# ── VirtIO RNG (getrandom() for Wasmtime startup) ────────────────────────────
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# ── 9P filesystem (host directory sharing via QEMU -virtfs) ──────────────────
# CONFIG_NETWORK_FILESYSTEMS gate needed for CONFIG_9P_FS (lives in fs/Kconfig)
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# ── DRM / virtio-gpu (QEMU graphical window) ──────────────────────────────────
# DRM_VIRTIO_GPU provides the virtio-gpu KMS driver.
# DRM_FBDEV_EMULATION bridges DRM → /dev/fb0 for supervisor mmap access.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y

# ── Framebuffer console (text rendered to graphical window) ───────────────────
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# ── Input subsystem + PS/2 keyboard (QEMU default keyboard device) ────────────
# Without these, /dev/tty0 receives no keyboard input — the hardware has no driver.
# QEMU emulates a PS/2 keyboard via i8042; ATKBD is the Linux driver for it.
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y

# ── Virtual terminal (VT) + console input ─────────────────────────────────────
# VT provides /dev/ttyN devices; VT_CONSOLE wires keyboard events to them.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_UNIX98_PTYS=y

# ── evdev interface + VirtIO input device ───────────────────────────────────
# evdev: exposes raw input events via /dev/input/eventN (used by mouse thread)
CONFIG_INPUT_EVDEV=y
# virtio-input: kernel driver for QEMU virtio-input PCI device (mouse/keyboard)
CONFIG_VIRTIO_INPUT=y

# ── Linux namespaces (P27) ─────────────────────────────────────────────────────
# Required for per-app mount + PID namespace isolation via unshare().
# Supervisor calls unshare(CLONE_NEWNS|CLONE_NEWPID) in pre_exec before seccomp.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_MNT_NS=y
CONFIG_NET_NS=y
